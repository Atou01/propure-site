# --- Claude (obligatoire) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modèle par défaut. Alternatives moins chères : claude-sonnet-5, claude-haiku-4-5
HERMES_MODEL=claude-opus-4-8

# --- Apollo.io (obligatoire pour le Scout) ---
APOLLO_API_KEY=...

# --- Envoi du digest quotidien (SMTP de ton domaine, ex. Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hermes@ton-domaine.ch
SMTP_PASS=...
DIGEST_FROM="Hermes <hermes@ton-domaine.ch>"
DIGEST_TO=toi@ton-domaine.ch

# --- Réglages ---
# Nombre max de prospects analysés en profondeur par exécution
DAILY_PROSPECT_LIMIT=10
